# Shiori Mini App — environment

# Required: self-hosted API
VITE_SHIORI_API_URL=http://localhost:4001

# Daramet donation page (subscription payment)
# VITE_DARAMET_DONATE_URL=https://daramet.com/your-username

# Upload bot — file download deep links (start=get_… / pack_…)
# VITE_TELEGRAM_BOT_USERNAME=ShioriUploadBot

# Mini App host bot — share / startapp / profile footer
# VITE_TELEGRAM_MINI_APP_BOT_USERNAME=ShioriMiniBot

# Post-splash “what's new” popup (Profile archive stays available either way)
# Set false during heavy beta so users aren't interrupted every deploy
# VITE_SHOW_RELEASE_NOTES=false

# Web mini-app preview (desktop browser) — allowlisted Telegram user ids only
# VITE_WEB_MINIAPP_ALLOWLIST=90344148
# One-time unlock: https://shiori.cloud/?web_preview=YOUR_SECRET (set on server .env, not in git)
# VITE_WEB_MINIAPP_PREVIEW_KEY=

# Optional: image column override (legacy; API returns image URLs directly)
# VITE_ANIME_IMAGE_COLUMN=cover_image
